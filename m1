#property copyright "Converted by ChatGPT"
#property link      ""
#property version   "1.00"
#property strict

//--- INPUTS (tweak to match your needs)
input string TradeSymbol            = "XAUUSD";    // symbol to trade
input double TRADE_AMOUNT_USD       = 10.0;        // margin-like amount in USD used in original script
input int    LEVERAGE               = 30;          // logical leverage multiplier (broker leverage still applies)
input double MIN_NOTIONAL_USD       = 10.0;        // minimum notional required
input int    SEQ_LEN                = 20;          // buffer length (sequence length)
input int    FUTURE_STEP_FOR_LABEL  = 3;           // how many future ticks used for label majority
input int    TRADE_HOLD_STEPS       = 1;           // hold time in ticks
input double SLIPPAGE_POINTS        = 3;           // allowed slippage in points
input double MIN_INTERVAL_BETWEEN_ORDERS = 0.2;    // seconds
input int    MAX_ORDERS_PER_MINUTE  = 80;          // cap orders per minute
input double LotsMin                = 0.01;        // minimum allowed lot
input double LotsStep               = 0.01;        // lot step (broker dependent)
input int    PrintEveryTicks        = 1;           // print debug every N ticks

//--- internal globals
double midBuffer[];             // circular buffer for mid prices/features
int    bufIndex = 0;
int    bufCount = 0;

datetime orderTimestamps[200];  // timestamps for rate limiting (simple ring)
int      tsCount = 0;

struct OpenTrade {
  int    ticket;
  double entryPrice;
  string side; // "UP" or "DOWN"
  int    openedOnTick;
  double lots;
  double notional;
};
OpenTrade openTrades[];

// predictor queue (store last FUTURE_STEP_FOR_LABEL predictions)
string futurePreds[];
int tickIndex = 0;

int wins=0, losses=0;
double balance_at_start = 0.0;

// last order time for min interval
double lastOrderTime = 0.0;

// rolling accuracy buffer
int accuracyBufferLen = 50;
int accuracyBuffer[]; // store 0/1
int accIdx = 0, accCount = 0;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
{
   ArrayResize(midBuffer, SEQ_LEN);
   ArrayInitialize(midBuffer, 0.0);

   ArrayResize(orderTimestamps, MAX_ORDERS_PER_MINUTE + 5);
   ArrayInitialize(orderTimestamps, 0);

   ArrayResize(futurePreds, FUTURE_STEP_FOR_LABEL);
   ArrayInitialize(futurePreds, "");

   ArrayResize(accuracyBuffer, accuracyBufferLen);
   ArrayInitialize(accuracyBuffer, 0);

   balance_at_start = AccountBalance();

   PrintFormat("[INIT] EA initialized for %s | TRADE_AMOUNT_USD=%.2f | LEVERAGE=%d", TradeSymbol, TRADE_AMOUNT_USD, LEVERAGE);
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Rate-limiter helper                                               |
//+------------------------------------------------------------------+
bool RateLimiterWaitSlot()
{
   double now_sec = (double)TimeCurrent();

   // enforce min interval
   if(now_sec - lastOrderTime < MIN_INTERVAL_BETWEEN_ORDERS)
      return(false);

   // remove old timestamps older than 60s
   int keep=0;
   for(int i=0;i<tsCount;i++){
      if((double)orderTimestamps[i] >= (TimeCurrent() - 60))
      {
         orderTimestamps[keep++] = orderTimestamps[i];
      }
   }
   tsCount = keep;

   if(tsCount >= MAX_ORDERS_PER_MINUTE) // reached capacity
      return(false);

   // append now
   if(tsCount < ArraySize(orderTimestamps))
   {
      orderTimestamps[tsCount++] = TimeCurrent();
   }
   lastOrderTime = now_sec;
   return(true);
}

//+------------------------------------------------------------------+
//| Helper: compute lots from notional logic similar to Python script|
//| Python used: size = (TRADE_AMOUNT * LEVERAGE) / entry_price     |
//| For XAUUSD, 1 lot = 100 ounces typically -> lot = size / 100     |
//+------------------------------------------------------------------+
double ComputeLots(double entryPrice)
{
   double size_ounces = (TRADE_AMOUNT_USD * LEVERAGE) / entryPrice; // number of ounces
   double lots = size_ounces / 100.0; // assume 1 lot = 100 ounces
   // enforce broker lot constraints
   if(lots < LotsMin) return(0.0);
   // round to lot step
   int steps = (int)MathFloor(lots / LotsStep);
   double normLots = steps * LotsStep;
   if(normLots < LotsMin) return(0.0);
   return(NormalizeDouble(normLots, 2));
}

//+------------------------------------------------------------------+
//| Place market order wrapper                                       |
//+------------------------------------------------------------------+
int PlaceMarketOrder(string side, double price, double lots, bool isExit=false)
{
   if(!RateLimiterWaitSlot())
   {
      Print("[RATE_LIMIT] blocked order due to rate limiter");
      return(-1);
   }

   int slippage = (int)SLIPPAGE_POINTS;
   int ticket = -1;
   if(side == "UP")
   {
      // buy at Ask
      double ask = MarketInfo(TradeSymbol, MODE_ASK);
      ticket = OrderSend(TradeSymbol, OP_BUY, lots, ask, slippage, 0, 0, "HF_EA", 0, 0, clrGreen);
      if(ticket < 0)
         PrintFormat("[ERROR] OrderSend BUY failed: %d - %s", GetLastError(), ErrorDescription(GetLastError()));
   }
   else
   {
      // sell at Bid
      double bid = MarketInfo(TradeSymbol, MODE_BID);
      ticket = OrderSend(TradeSymbol, OP_SELL, lots, bid, slippage, 0, 0, "HF_EA", 0, 0, clrRed);
      if(ticket < 0)
         PrintFormat("[ERROR] OrderSend SELL failed: %d - %s", GetLastError(), ErrorDescription(GetLastError()));
   }
   return(ticket);
}

//+------------------------------------------------------------------+
//| Simple predictor: emulate 'made prediction' by looking at last   |
//| SEQ_LEN mid price pattern. We use a majority-of-next-steps logic.|
//+------------------------------------------------------------------+
string MakePrediction()
{
   // If not enough buffer, default DOWN
   if(bufCount < SEQ_LEN) return("DOWN");

   // naive predictor: look at last FUTURE_STEP_FOR_LABEL mid diffs
   int ups=0, downs=0;
   int start = bufCount - FUTURE_STEP_FOR_LABEL;
   if(start < 1) start = 1;
   for(int i = bufCount - FUTURE_STEP_FOR_LABEL; i < bufCount; i++)
   {
      double a = midBuffer[(i-1+SEQ_LEN)%SEQ_LEN];
      double b = midBuffer[(i+0)%SEQ_LEN];
      if(b > a) ups++; else downs++;
   }
   return(ups >= downs ? "UP" : "DOWN");
}

//+------------------------------------------------------------------+
//| Called on every tick                                              |
//+------------------------------------------------------------------+
void OnTick()
{
   static int debugCounter = 0;
   // operate only on configured symbol
   if(Symbol() != TradeSymbol)
      return;

   double bid = MarketInfo(TradeSymbol, MODE_BID);
   double ask = MarketInfo(TradeSymbol, MODE_ASK);
   if(bid <= 0 || ask <= 0) return;

   double mid = (bid + ask) / 2.0;

   // add to circular buffer
   midBuffer[bufIndex] = mid;
   bufIndex = (bufIndex + 1) % SEQ_LEN;
   if(bufCount < SEQ_LEN) bufCount++;

   tickIndex++;

   // Step 1: make prediction when buffer full
   string pred = "";
   if(bufCount == SEQ_LEN)
   {
      pred = MakePrediction();
      // push into futurePreds queue
      for(int i=0;i<FUTURE_STEP_FOR_LABEL-1;i++) futurePreds[i]=futurePreds[i+1];
      futurePreds[FUTURE_STEP_FOR_LABEL-1] = pred;

      if(debugCounter % PrintEveryTicks == 0)
         PrintFormat("[%s] MADE_PRED tick=%d Pred=%s mid=%.5f", TimeToString(TimeCurrent(), TIME_SECONDS), tickIndex, pred, mid);
   }

   // Step 2: label & "train" when we have FUTURE_STEP_FOR_LABEL preds
   bool have_future_preds = true;
   for(int i=0;i<FUTURE_STEP_FOR_LABEL;i++) if(futurePreds[i]=="") have_future_preds=false;

   if(have_future_preds)
   {
      // determine actual direction between current mid and mid FUTURE_STEP_FOR_LABEL ticks ago
      int idx_past = (bufIndex - FUTURE_STEP_FOR_LABEL + SEQ_LEN) % SEQ_LEN;
      double mid_past = midBuffer[idx_past];
      string actual_dir = (mid > mid_past) ? "UP" : "DOWN";

      int correctCount=0;
      for(int i=0;i<FUTURE_STEP_FOR_LABEL;i++) if(futurePreds[i] == actual_dir) correctCount++;
      double correct = (double)correctCount / FUTURE_STEP_FOR_LABEL;

      // rolling acc: append 1 if all predictions matched actual (similar to original correct==1)
      int appendVal = (correct == 1.0) ? 1 : 0;
      accuracyBuffer[accIdx] = appendVal;
      accIdx = (accIdx + 1) % accuracyBufferLen;
      if(accCount < accuracyBufferLen) accCount++;

      int sumAcc=0;
      for(int i=0;i<accCount;i++) sumAcc += accuracyBuffer[i];
      double rollingAcc = accCount ? ((double)sumAcc / accCount) * 100.0 : 0.0;

      if(debugCounter % PrintEveryTicks == 0)
         PrintFormat("[%s] LABEL tick=%d Actual=%s Correct=%s RolAcc=%.1f%%", TimeToString(TimeCurrent(), TIME_SECONDS), tickIndex, actual_dir, (correct==1.0) ? "True" : "False", rollingAcc);

      // Step 3: trade entry: only if all FUTURE preds agree AND rollingAcc >= 50% AND no open trades
      bool allAgree = true;
      for(int i=1;i<FUTURE_STEP_FOR_LABEL;i++) if(futurePreds[i] != futurePreds[0]) allAgree = false;

      if(allAgree && rollingAcc >= 50.0 && ArraySize(openTrades) == 0 && correct == 1.0)
      {
         string tradeSide = futurePreds[0]; // "UP" or "DOWN"
         double entryPrice = mid;
         double notional = TRADE_AMOUNT_USD * LEVERAGE;
         if(notional >= MIN_NOTIONAL_USD)
         {
            double lots = ComputeLots(entryPrice);
            if(lots > 0.0)
            {
               int ticket = PlaceMarketOrder(tradeSide, entryPrice, lots, false);
               if(ticket > 0)
               {
                  // record open trade
                  OpenTrade t;
                  t.ticket = ticket;
                  t.entryPrice = entryPrice;
                  t.side = tradeSide;
                  t.openedOnTick = tickIndex;
                  t.lots = lots;
                  t.notional = notional;
                  ArrayResize(openTrades, ArraySize(openTrades) + 1);
                  openTrades[ArraySize(openTrades)-1] = t;

                  PrintFormat("💰 ENTER %s | $%.2f margin (logical) | notional=$%.2f @ %.5f lots=%.2f Bal=%.2f",
                              tradeSide, TRADE_AMOUNT_USD, notional, entryPrice, lots, AccountBalance());
               }
               else
               {
                  Print("[ERROR] Entry order failed or rate-limited.");
               }
            }
            else
            {
               Print("[SKIP] Computed lots too small for broker constraints.");
            }
         }
         else
         {
            PrintFormat("[SKIP] Notional too small: %.2f < MIN_NOTIONAL_USD %.2f", notional, MIN_NOTIONAL_USD);
         }
      }
   }

   // Step 4: close trades after hold steps
   if(ArraySize(openTrades) > 0)
   {
      int keepCount = 0;
      for(int i=0;i<ArraySize(openTrades);i++)
      {
         OpenTrade tr = openTrades[i];
         if(tickIndex >= tr.openedOnTick + TRADE_HOLD_STEPS)
         {
            // close
            bool closed = false;
            // refresh order select
            if(OrderSelect(tr.ticket, SELECT_BY_TICKET))
            {
               double closePrice = (tr.side == "UP") ? MarketInfo(TradeSymbol, MODE_BID) : MarketInfo(TradeSymbol, MODE_ASK);
               bool ok = OrderClose(tr.ticket, tr.lots, closePrice, (int)SLIPPAGE_POINTS, clrYellow);
               if(ok)
               {
                  double pnl = (tr.side == "UP") ? ((closePrice - tr.entryPrice) / tr.entryPrice) * tr.notional
                                               : ((tr.entryPrice - closePrice) / tr.entryPrice) * tr.notional;
                  if(pnl >= 0) { wins++; PrintFormat("🏆 WIN | %s | Entry=%.5f Exit=%.5f PnL=$%.2f | Balance=%.2f", tr.side, tr.entryPrice, closePrice, pnl, AccountBalance()); }
                  else { losses++; PrintFormat("💀 LOSS | %s | Entry=%.5f Exit=%.5f PnL=$%.2f | Balance=%.2f", tr.side, tr.entryPrice, closePrice, pnl, AccountBalance()); }
               }
               else
               {
                  PrintFormat("[RETRY_EXIT] Close failed ticket=%d err=%d", tr.ticket, GetLastError());
                  // try again later: keep trade
                  ArrayResize(openTrades, keepCount+1);
                  openTrades[keepCount++] = tr;
                  continue;
               }
            }
            else
            {
               PrintFormat("[WARN] Could not select order %d for close", tr.ticket);
            }
         }
         else
         {
            // keep trade
            ArrayResize(openTrades, keepCount+1);
            openTrades[keepCount++] = tr;
         }
      }
      // trim array to kept trades
      ArrayResize(openTrades, keepCount);
   }

   debugCounter++;
}

//+------------------------------------------------------------------+
//| Utility: human-readable error description                        |
//+------------------------------------------------------------------+
string ErrorDescription(int code)
{
   // minimal mapping (expand as needed)
   switch(code)
   {
      case 1: return "No error returned";
      case 2: return "Common error";
      case 3: return "Invalid trade parameters";
      case 4: return "Trade server is busy";
      case 5: return "Old version of client terminal";
      case 6: return "No connection with trade server";
      case 7: return "Not enough rights";
      case 8: return "Too frequent requests";
      default: return "ErrCode:" + IntegerToString(code);
   }
}

