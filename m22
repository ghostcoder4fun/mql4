#property copyright "Converted by ChatGPT"
#property link      ""
#property version   "1.33"
#property strict

//--- INPUTS
input string TradeSymbol            = "XAUUSD";
input double TRADE_AMOUNT_USD       = 10.0;
input int    LEVERAGE               = 100;
input bool   AUTO_LEVERAGE          = true;
input double MIN_NOTIONAL_USD       = 10.0;
input int    SEQ_LEN                = 20;
input int    FUTURE_STEP_FOR_LABEL  = 2;
input int    TRADE_HOLD_STEPS       = 1;
input double SLIPPAGE_POINTS        = 3;
input double MIN_INTERVAL_BETWEEN_ORDERS = 0.2;
input int    MAX_ORDERS_PER_MINUTE  = 80;
input double LotsMin                = 0.01;
input double LotsStep               = 0.01;
input int    PrintEveryTicks        = 1;
input int    MIN_CONSECUTIVE_SIGNS  = 2;

//--- internal globals
double midBuffer[];
double emaBuffer[];
int    bufIndex = 0;
int    bufCount = 0;

datetime orderTimestamps[200];
int      tsCount = 0;

struct OpenTrade {
  int    ticket;
  double entryPrice;
  string side;
  int    openedOnTick;
  double lots;
  double notional;
};
OpenTrade openTrades[];

string futurePreds[];
int tickIndex = 0;

int wins=0, losses=0;
double balance_at_start = 0.0;
double lastOrderTime = 0.0;
string lastPred = "";  // <-- used as the *current* state memory

double tickThreshold = 0.05;
double emaAlpha = 0.3;

//+------------------------------------------------------------------+
int OnInit()
{
   ArrayResize(midBuffer, SEQ_LEN);
   ArrayInitialize(midBuffer, 0.0);

   ArrayResize(emaBuffer, SEQ_LEN);
   ArrayInitialize(emaBuffer, 0.0);

   ArrayResize(orderTimestamps, MAX_ORDERS_PER_MINUTE + 5);
   ArrayInitialize(orderTimestamps, 0);

   ArrayResize(futurePreds, FUTURE_STEP_FOR_LABEL);
   for(int i=0; i<FUTURE_STEP_FOR_LABEL; i++) futurePreds[i] = "";

   balance_at_start = AccountBalance();

   PrintFormat("[INIT] EA initialized for %s,M1 | TRADE_AMOUNT_USD=%.2f | LEVERAGE=%d | FUTURE_STEP_FOR_LABEL=%d",
               TradeSymbol, TRADE_AMOUNT_USD, LEVERAGE, FUTURE_STEP_FOR_LABEL);

   return(INIT_SUCCEEDED);
}
//+------------------------------------------------------------------+
bool RateLimiterWaitSlot()
{
   double now_sec = (double)TimeCurrent();
   if(now_sec - lastOrderTime < MIN_INTERVAL_BETWEEN_ORDERS)
   {
      Print("[RATE_LIMIT] Not enough time since last order");
      return(false);
   }

   int keep=0;
   for(int i=0; i<tsCount; i++){
      if((double)orderTimestamps[i] >= (TimeCurrent() - 60))
         orderTimestamps[keep++] = orderTimestamps[i];
   }
   tsCount = keep;

   if(tsCount >= MAX_ORDERS_PER_MINUTE)
   {
      Print("[RATE_LIMIT] Too many orders in the last minute");
      return(false);
   }

   orderTimestamps[tsCount++] = TimeCurrent();
   lastOrderTime = now_sec;
   return(true);
}
//+------------------------------------------------------------------+
double GetMinLeverage(double tradeAmountUSD, double entryPrice)
{
   double contractSize = MarketInfo(TradeSymbol, MODE_LOTSIZE);
   if(contractSize <= 0) contractSize = 100.0;

   double size_ounces = tradeAmountUSD / entryPrice;
   double lots_needed = size_ounces / contractSize;

   if(lots_needed < LotsMin)
   {
      double minLeverage = (LotsMin * contractSize * entryPrice) / tradeAmountUSD;
      PrintFormat("[AUTO_LEVERAGE] Minimum leverage required=%.0f for TRADE_AMOUNT=%.2f, entryPrice=%.5f",
                  minLeverage, tradeAmountUSD, entryPrice);
      return(minLeverage);
   }
   return(LEVERAGE);
}
//+------------------------------------------------------------------+
double ComputeLots(double entryPrice)
{
   double contractSize = MarketInfo(TradeSymbol, MODE_LOTSIZE);
   if(contractSize <= 0) contractSize = 100.0;

   double effectiveLeverage = LEVERAGE;
   if(AUTO_LEVERAGE) effectiveLeverage = GetMinLeverage(TRADE_AMOUNT_USD, entryPrice);

   double size_ounces = (TRADE_AMOUNT_USD * effectiveLeverage) / entryPrice;
   double lots = size_ounces / contractSize;

   if(lots < LotsMin) return(0.0);

   int steps = (int)MathFloor(lots / LotsStep);
   double normLots = steps * LotsStep;
   if(normLots < LotsMin) return(0.0);

   return NormalizeDouble(normLots, 2);
}
//+------------------------------------------------------------------+
int PlaceMarketOrder(string side, double price, double lots)
{
   if(!RateLimiterWaitSlot()) return(-1);

   int slippage = (int)SLIPPAGE_POINTS;
   int ticket = -1;

   if(side == "UP") ticket = OrderSend(TradeSymbol, OP_BUY,  lots, MarketInfo(TradeSymbol, MODE_ASK), slippage, 0, 0);
   else             ticket = OrderSend(TradeSymbol, OP_SELL, lots, MarketInfo(TradeSymbol, MODE_BID), slippage, 0, 0);

   return(ticket);
}
//+------------------------------------------------------------------+
void ManageOpenTrades()
{
   if(ArraySize(openTrades) == 0) return;

   string nextPred = futurePreds[FUTURE_STEP_FOR_LABEL-1];

   for(int i=ArraySize(openTrades)-1; i>=0; i--)
   {
      OpenTrade t = openTrades[i];
      bool shouldExit = false;

      if(t.side == "UP"   && nextPred == "DOWN") shouldExit = true;
      if(t.side == "DOWN" && nextPred == "UP")   shouldExit = true;
      if(lastPred == "MID" && nextPred == "MID") shouldExit = true;

      if(shouldExit)
      {
         double closePrice = (t.side == "UP") ? MarketInfo(TradeSymbol, MODE_BID)
                                             : MarketInfo(TradeSymbol, MODE_ASK);

         if(OrderSelect(t.ticket, SELECT_BY_TICKET))
            OrderClose(t.ticket, t.lots, closePrice, (int)SLIPPAGE_POINTS, clrYellow);

         for(int j=i; j<ArraySize(openTrades)-1; j++) openTrades[j] = openTrades[j+1];
         ArrayResize(openTrades, ArraySize(openTrades)-1);
      }
   }

   lastPred = nextPred;
}
//+------------------------------------------------------------------+
double UpdateEMA(double price)
{
   double prevEMA = (bufCount == 1) ? price : emaBuffer[(bufIndex - 1 + SEQ_LEN) % SEQ_LEN];
   double newEMA = emaAlpha * price + (1.0 - emaAlpha) * prevEMA;
   emaBuffer[bufIndex] = newEMA;
   return(newEMA);
}
//+------------------------------------------------------------------+
string MakePrediction()
{
   if(bufCount < SEQ_LEN) return "MID";

   double ema = UpdateEMA(midBuffer[(bufIndex - 1 + SEQ_LEN) % SEQ_LEN]);
   double prevEma = emaBuffer[(bufIndex - 2 + SEQ_LEN) % SEQ_LEN];
   double delta = ema - prevEma;

   if(delta >  tickThreshold) return "UP";
   if(delta < -tickThreshold) return "DOWN";
   return "MID";
}
//+------------------------------------------------------------------+
void OnTick()
{
   static int debugCounter = 0;
   if(Symbol() != TradeSymbol) return;
   tickIndex++;

   ManageOpenTrades();

   double bid = MarketInfo(TradeSymbol, MODE_BID);
   double ask = MarketInfo(TradeSymbol, MODE_ASK);
   if(bid <= 0 || ask <= 0) return;

   double mid = (bid + ask) / 2.0;
   midBuffer[bufIndex] = mid;
   bufIndex = (bufIndex + 1) % SEQ_LEN;
   if(bufCount < SEQ_LEN) bufCount++;

   string pred = MakePrediction();

   for(int i=0;i<FUTURE_STEP_FOR_LABEL-1;i++)
      futurePreds[i]=futurePreds[i+1];

   futurePreds[FUTURE_STEP_FOR_LABEL-1] = pred;

   if(debugCounter % PrintEveryTicks == 0)
      PrintFormat("[%s] Pred=%s mid=%.5f", TimeToString(TimeCurrent(), TIME_SECONDS), pred, mid);

   //===========================================================
   // *** UPDATED ENTRY BLOCK START ***
   // EARLY ENTRY: enter on transition (current → next)
   //===========================================================
   string currState = lastPred;
   string nextState = pred;

   bool enterLong  = ((currState == "MID" || currState == "DOWN") && nextState == "UP");
   bool enterShort = ((currState == "MID" || currState == "UP")   && nextState == "DOWN");

   if(ArraySize(openTrades) == 0 && (enterLong || enterShort))
   {
      string tradeSide = enterLong ? "UP" : "DOWN";
      double entryPrice = mid;
      double notional = TRADE_AMOUNT_USD * LEVERAGE;

      if(notional >= MIN_NOTIONAL_USD)
      {
         double lots = ComputeLots(entryPrice);
         if(lots > 0.0)
         {
            int ticket = PlaceMarketOrder(tradeSide, entryPrice, lots);
            if(ticket > 0)
            {
               OpenTrade t;
               t.ticket = ticket;
               t.entryPrice = entryPrice;
               t.side = tradeSide;
               t.openedOnTick = tickIndex;
               t.lots = lots;
               t.notional = notional;
               ArrayResize(openTrades, ArraySize(openTrades)+1);
               openTrades[ArraySize(openTrades)-1] = t;

               PrintFormat("🚀 EARLY ENTER %s | curr=%s → next=%s @ %.5f",
                           tradeSide, currState, nextState, entryPrice);
            }
         }
      }
   }
   // update last state AFTER logic
   lastPred = pred;
   //===========================================================
   // *** UPDATED ENTRY BLOCK END ***
   //===========================================================

   debugCounter++;
}
//+------------------------------------------------------------------+
string ErrorDescription(int code)
{
   switch(code)
   {
      case 1: return "No error returned";
      case 2: return "Common error";
      case 3: return "Invalid trade parameters";
      case 4: return "Trade server busy";
      case 6: return "No connection";
      case 8: return "Too frequent requests";
      default: return "ErrCode:" + IntegerToString(code);
   }
}
